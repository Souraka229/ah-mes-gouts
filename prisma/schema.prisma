// Schéma Prisma — Ah Mes Goûts (backend NestJS à brancher)
// Les champs expéditeur (client_*) restent toujours en base pour l'admin,
// même si sender_visible = false (anonymat = destinataire uniquement).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  RECUE
  PAIEMENT_CONFIRME
  PREPARATION
  PRETE
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

enum ReceptionMode {
  DELIVERY
  PICKUP
  DINEIN
}

enum PaymentMethod {
  MTN_MOMO
  MOOV_MONEY
  CELTIIS_CASH
  CARD
}

enum PaymentAttemptStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

/// Palier de livraison — « Destinations A », « Hors Cotonou »…
///
/// `cost` reste le tarif du palier pour A–E, mais il n'est plus la source de
/// vérité du montant facturé : **le prix est porté par le lieu**
/// (`DeliveryArea.price`). Une zone n'est qu'un regroupement, rangé par prix.
model DeliveryZone {
  id        String   @id @default(cuid())
  name      String
  cost      Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas DeliveryArea[]
}

/// Lieu livré — le prix que la cliente paie vient d'ici.
///
/// Séparé de la zone parce que la grille réelle ne se laisse pas réduire à un
/// tarif par palier : « Hors Cotonou » va de 2 000 à 4 000 F selon le lieu, et
/// certaines zones mélangent plusieurs prix. Sans cette table, corriger le tarif
/// d'un seul quartier demandait un déploiement.
model DeliveryArea {
  id        String   @id @default(cuid())
  zoneId    String
  /// `Restrict`, jamais `Cascade` : supprimer une zone ne doit pas pouvoir
  /// effacer la grille tarifaire en silence. Voir la migration
  /// `20260921200000_delivery_area_no_cascade`.
  zone      DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  name      String
  /// Tarif en FCFA — entier, jamais négatif.
  price     Int
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zoneId, name])
  @@index([zoneId, isActive, sortOrder])
}

model DeliverySchedule {
  id           String  @id @default(cuid())
  dayOfWeek    Int
  startTime    String
  endTime      String
  slotDuration Int     @default(30)
  type         String
  isActive     Boolean @default(true)
}

/// Réglages globaux livraison (créneaux, capacité) — édités par l'admin.
model DeliveryOptions {
  id               String   @id @default("default")
  maxOrdersPerSlot Int      @default(5)
  bookingDaysAhead Int      @default(7)
  pickupAddress    String   @default("Gift & ENTREMETS — Cotonou, Bénin")
  updatedAt        DateTime @updatedAt
}

model Driver {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  accessToken String   @unique @default(cuid())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  orders Order[]
}

/// Client CRM — pivot = téléphone normalisé (pas l'IP, pas le device).
model Customer {
  id           String    @id @default(cuid())
  phone        String    @unique
  firstName    String    @default("")
  lastName     String    @default("")
  firstOrderAt DateTime?
  lastOrderAt  DateTime?
  ordersCount  Int       @default(0)
  totalSpent   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  devices    CustomerDevice[]
  activities CustomerActivity[]
  orders     Order[]

  @@index([lastOrderAt])
  @@index([totalSpent])
  @@index([ordersCount])
}

/// Appareil navigateur (LocalStorage) — peut être lié à un Customer.
model CustomerDevice {
  id         String    @id @default(cuid())
  deviceKey  String    @unique
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  activities CustomerActivity[]

  @@index([customerId])
}

enum CustomerActivityType {
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_START
  ORDER_PLACED
}

model CustomerActivity {
  id          String               @id @default(cuid())
  deviceId    String
  device      CustomerDevice       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  type        CustomerActivityType
  productId   String?
  productSlug String?
  productName String?
  metadata    Json?
  createdAt   DateTime             @default(now())

  @@index([customerId, createdAt])
  @@index([deviceId, createdAt])
  @@index([type, createdAt])
}

/// Code à usage unique pour récupérer l'historique sur un nouvel appareil.
model CustomerOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Order {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status        OrderStatus   @default(RECUE)
  mode          ReceptionMode
  zoneId        String?
  zoneName      String?
  deliveryZoneId       String?
  scheduledSlotStart   DateTime?
  scheduledSlotEnd     DateTime?
  fulfillmentType      String    @default("delivery")
  deliveryFee   Int           @default(0)
  subtotal      Int
  total         Int
  paymentMethod PaymentMethod
  paymentReference String?
  /// web | whatsapp — canal d’initiation du paiement (analytics / bot).
  salesChannel  String   @default("web")

  /// Jeton de suivi opaque — remis une seule fois à la création.
  /// Exigé par /api/orders/[id]/tracking : ferme l'énumération de commandes.
  /// Nullable pour les commandes antérieures à la migration, qui restent
  /// consultables par ID seul le temps qu'elles sortent du circuit.
  trackingToken String? @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  driverId          String?
  driver            Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverStartedAt   DateTime?
  driverDeliveredAt DateTime?

  // Expéditeur / facturation (toujours stocké — visible admin uniquement si cadeau anonyme)
  clientFirstName String
  clientLastName  String
  clientPhone     String
  clientAddress   String?
  clientLandmark  String?
  clientMessage   String?

  // Commande cadeau
  isGift          Boolean @default(false)
  recipientName   String?
  recipientPhone  String?
  recipientAddress String?
  recipientLandmark String?
  giftMessage     String? @db.VarChar(280)
  senderVisible   Boolean @default(true)

  // Anti-fraude (IP hashée, jamais en clair)
  clientIpHash String?

  items    OrderItem[]
  attempts PaymentAttempt[]

  @@index([clientPhone])
  @@index([customerId])
  @@index([createdAt])
  @@index([driverId])
  @@index([driverId, fulfillmentType, status])
  @@index([driverId, scheduledSlotStart])
  @@index([status])
  @@index([scheduledSlotStart, fulfillmentType, status])
  @@index([paymentReference])
}

/// Tentative de paiement — l'objet qui manquait.
///
/// Une commande a des tentatives ; une tentative appartient à une commande et
/// une seule ; une référence FeexPay est unique GLOBALEMENT. C'est cette
/// contrainte d'unicité, au niveau base, qui rend le rejeu impossible : une
/// référence déjà encaissée ne peut plus créditer aucune autre commande.
///
/// `amount` est figé à l'initiation depuis le total serveur : le webhook
/// compare à cette valeur, jamais à un montant relu du client.
model PaymentAttempt {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  reference String               @unique
  method    PaymentMethod
  amount    Int
  status    PaymentAttemptStatus @default(PENDING)

  initiatedAt DateTime  @default(now())
  settledAt   DateTime?

  /// Dernière réponse FeexPay brute — indispensable en litige client.
  lastRawResponse Json?
  failureReason   String?

  @@index([status, initiatedAt])
  @@index([orderId])
}

/// Session admin signée et révocable — remplace le token statique en cookie.
model AdminSession {
  id         String    @id @default(cuid())
  role       String
  name       String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  ipHash     String?

  @@index([expiresAt])
}

/// Idempotence checkout — remplace le cache RAM multi-instance.
model OrderIdempotencyKey {
  key       String   @id
  orderId   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Rate limiting distribué (remplace Map process-local).
model RateLimitBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  slug     String?
  name     String
  quantity Int
  unitPrice Int
  supplements String[] @default([])
  /// Snapshot de la variante choisie (taille, format…).
  ///
  /// Volontairement **sans clé étrangère** : une variante désactivée ou
  /// supprimée ne doit jamais pouvoir casser une commande passée. Le libellé
  /// et le prix sont figés ici, la commande reste lisible pour toujours.
  variantId    String?
  variantLabel String?

  /// Compléments et personnalisations choisis — snapshot complet, même règle
  /// que la variante : aucun prix n'est relu du catalogue après coup.
  options OrderItemOption[]
}

enum MenuStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
}

model Product {
  id              String   @id
  slug            String   @unique
  name            String
  description     String   @default("")
  price           Int
  imageUrl        String
  imageUrls       String[] @default([])
  keyword         String?
  stockRemaining  Int
  stockMinimum    Int      @default(5)
  isNew           Boolean  @default(false)
  isPromotion     Boolean  @default(false)
  promotionPrice  Int?
  isMenuDuJour    Boolean  @default(false)
  isPopular       Boolean  @default(false)
  isGiftCard      Boolean  @default(false)
  giftCardMessage String?
  category        String   @default("Entremets")
  /// draft | published | hidden.
  ///
  /// Défaut « published » : les produits existants restent visibles, aucune
  /// donnée à reprendre. Un brouillon ne doit jamais fuiter côté public — la
  /// policy RLS `product_public_read` filtre là-dessus.
  visibility      String   @default("published")
  /// Libellé du sélecteur de variante : « Taille », « Format », « Personnes ».
  variantLabel    String?
  /// Sous-type libre, piloté par l'admin (nounours : stitch | teddy | labubu).
  subtype         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants     ProductVariant[]
  optionGroups ProductOptionGroup[]
}

/// Variante d'un produit — tailles de nounours, formats de bouquet, nombre de
/// personnes d'un entremets. **Générique** : le prix d'une ligne de commande est
/// résolu depuis ici, jamais depuis le client.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Ce que le client envoie — identifiant stable : "150", "petit", "6".
  code  String
  /// Ce qui s'affiche : "150 cm", "Petit", "6 personnes".
  label String
  price Int
  /// Ordre d'affichage, et valeur de tri.
  sortOrder Int     @default(0)
  /// Une variante inactive disparaît du site et est refusée au checkout.
  isActive  Boolean @default(true)
  /// Stock propre à la variante. `null` = stock porté par le produit.
  stockRemaining Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, code])
  @@index([productId, isActive, sortOrder])
}

/// Groupe d'options — « Messages », « Champagne sans alcool », « Topper »…
///
/// À ne pas confondre avec `ProductVariant` :
///   * une **variante** est une déclinaison du produit (taille, format) ; son
///     prix **remplace** le prix de base et le client en choisit toujours une ;
///   * une **option** est un complément ; son prix **s'ajoute** au prix de base.
///
/// Un groupe est défini **une fois** puis rattaché à autant de produits que
/// voulu via `ProductOptionGroup`. Ajouter « Bougie anniversaire » dans six mois
/// ne demande donc aucune modification de code.
model OptionGroup {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  description   String   @default("")
  /// `single` (bouton radio) ou `multiple` (cases à cocher).
  selectionType String   @default("single")
  /// Bornes par défaut du groupe. Un produit peut les surcharger.
  minSelections Int      @default(0)
  maxSelections Int      @default(1)
  isRequired    Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  options  Option[]
  products ProductOptionGroup[]

  @@index([isActive, sortOrder])
}

/// Option — un choix concret dans un groupe, avec son prix.
///
/// `pricingType` décide de la facturation :
///   * `fixed`    → le prix est dû une fois, quelle que soit la quantité ;
///   * `per_unit` → le prix est dû **par unité** choisie (topper à 50 F).
///
/// Le prix de cette table est la **seule** source de vérité : le client n'envoie
/// qu'un identifiant, jamais un montant.
model Option {
  id          String      @id @default(cuid())
  groupId     String
  group       OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String      @default("")
  price       Int
  /// `fixed` | `per_unit`.
  pricingType String      @default("fixed")
  /// Unité affichée pour `per_unit` : « unité », « rose », « personne ».
  unitLabel   String?
  /// Sous-famille d'affichage à l'intérieur d'un groupe.
  ///
  /// Sert à ranger « Vin / Spiritueux » en « Champagne sans alcool » et
  /// « Champagne avec alcool » sans créer un groupe par sous-famille — le
  /// client voit des titres, le modèle reste plat.
  subgroupLabel String?
  imageUrl    String?
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  /// Stock propre à l'option. `null` = pas de suivi de stock.
  stockRemaining Int?
  /// Quantité maximale sélectionnable pour cette option (topper : 10).
  maxQuantity Int         @default(1)

  // ─── Personnalisation portée par l'option ───────────────────────────────
  /// `none` | `optional` | `required` — le client doit-il écrire un message ?
  messageMode        String  @default("none")
  messageMinLength   Int?
  messageMaxLength   Int?
  messagePlaceholder String?
  /// `none` | `optional` | `required` — le client doit-il choisir une occasion ?
  occasionMode        String  @default("none")
  /// Autorise « Autre » avec saisie libre de l'occasion.
  allowCustomOccasion Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, slug])
  @@index([groupId, isActive, sortOrder])
}

/// Rattachement d'un groupe à un produit, avec surcharges par produit.
///
/// `minSelections` / `maxSelections` à `null` = on applique la borne du groupe.
/// C'est ce qui permet d'autoriser dix toppers sur un entremets et un seul
/// ailleurs, sans dupliquer le groupe.
model ProductOptionGroup {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupId       String
  group         OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  minSelections Int?
  maxSelections Int?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([productId, groupId])
  @@index([productId, sortOrder])
}

/// Catégorie de message — Anniversaire, Amour, Fête des Mères…
///
/// **Système distinct des catégories de produits** (`Product.category`) : celles-ci
/// classent le catalogue, celles-là qualifient l'occasion d'un message. Les
/// mélanger rendrait les deux ingérables.
///
/// `allowsCustomText` ouvre la saisie libre (« Autre : Baptême »).
model MessageCategory {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  allowsCustomText Boolean  @default(false)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)

  /// Catégorie parente — un seul niveau, volontairement.
  ///
  /// « Fête spéciale » est une catégorie extensible : l'admin y ajoute Noël,
  /// Saint-Valentin, Nouvel An, Ramadan… sans qu'aucune de ces valeurs ne soit
  /// écrite dans le code. Les enfants ne sont proposés qu'après le choix du
  /// parent, ce qui évite d'allonger la liste principale.
  parentId String?
  parent   MessageCategory?  @relation("MessageCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MessageCategory[] @relation("MessageCategoryTree")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([parentId, sortOrder])
}

/// Snapshot d'une option choisie sur une ligne de commande.
///
/// Même contrat que `OrderItem.variantId` : `optionId` est conservé **sans clé
/// étrangère** pour la traçabilité, mais tout ce qui est facturé et affiché est
/// figé ici. Changer le prix d'une carte de 1 500 à 2 000 F ne réécrit donc
/// jamais une commande déjà passée.
model OrderItemOption {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  /// Référence de traçabilité — volontairement sans contrainte.
  optionId           String?
  groupNameSnapshot  String
  optionNameSnapshot String
  /// `fixed` | `per_unit` — fige aussi la **règle** appliquée ce jour-là.
  pricingType        String  @default("fixed")
  unitPriceSnapshot  Int
  quantity           Int     @default(1)
  totalPrice         Int

  /// Texte réellement écrit par la cliente.
  customMessage           String?
  /// Libellé de la catégorie au moment de la commande (« Anniversaire »).
  messageCategorySnapshot String?
  /// Occasion libre, quand « Autre » a été choisi.
  customOccasion          String?

  createdAt DateTime @default(now())

  @@index([orderItemId])
}

model Menu {
  id           String     @id
  date         DateTime
  activateAt   DateTime
  status       MenuStatus
  productIds   String[]
  displayOrder Int[]
  /** Stock du jour par produit (aligné sur productIds) — appliqué à l'activation 20h. */
  dailyStock   Int[]      @default([])
  /** Nom libre : « Brouillon vendredi », « Version A » — affiché dans le studio. */
  label        String?
  /** Suppression douce : le menu disparaît du studio mais reste en historique. */
  archivedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([status])
  @@index([activateAt])
  @@index([archivedAt])
}

model SiteSettingsStore {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

model AdminActionLog {
  id        String   @id
  createdAt DateTime @default(now())
  adminName String
  source    String
  action    String
  summary   String
  details   Json?

  @@index([createdAt])
  @@index([source, createdAt])
}

/// Flux minimal pour Supabase Realtime (statut public sans PII)
model OrderStatusFeed {
  id        String      @id
  status    OrderStatus
  updatedAt DateTime    @updatedAt
}

/// Visiteur unique par jour (cookie amg_vid → hash) — analytics boutique
model SiteVisitorDay {
  id          String   @id @default(cuid())
  day         String
  visitorHash String
  pageViews   Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([day, visitorHash])
  @@index([day])
}

/// Abonnements Web Push (back-office) — remplace Telegram.
/// Table posée pour le canal à venir ; aucun code ne l'écrit encore.
model PushSubscription {
  id        String   @id @default(cuid())
  /// Endpoint fourni par le navigateur — identifie l'abonnement de façon unique.
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Rôle du destinataire : "administrateur" | "employe".
  role      String   @default("administrateur")
  label     String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([isActive])
}

/// Journal léger agent WhatsApp (Kapso) — cockpit admin
model WhatsAppBotLog {
  id             String   @id @default(cuid())
  direction      String
  phoneLast4     String?
  intent         String?
  tier           String?
  bodyPreview    String   @db.VarChar(500)
  replyPreview   String?  @db.VarChar(500)
  usedLlm        Boolean  @default(false)
  llmProvider    String?
  kapsoMessageId String?  @unique
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

/// Session paiement in-chat WhatsApp (FeexPay + confirmation dans le chat).
model WhatsAppPaySession {
  id        String   @id @default(cuid())
  phoneKey  String   @unique
  state     String
  orderId   String?
  method    String?
  payPhone  String?
  reference String?
  amount    Int?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

/// Brouillon commande WhatsApp (panier → créneau → RECUE → paiement).
model WhatsAppOrderDraft {
  id             String   @id @default(cuid())
  phoneKey       String   @unique
  state          String
  cartJson       Json     @default("[]")
  mode           String?
  slotStart      String?
  slotEnd        String?
  firstName      String?
  lastName       String?
  paymentMethod  String?
  orderId        String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
}

/// Numéro MoMo mémorisé par cliente (WhatsApp) — normalisé E.164.
model WhatsAppSavedPayPhone {
  id        String   @id @default(cuid())
  phoneKey  String   @unique
  payPhone  String
  updatedAt DateTime @updatedAt
}

/// Jobs entrants — webhook répond 200 vite, traitement async + cron de secours.
model WhatsAppInboundQueue {
  id             String   @id @default(cuid())
  kapsoMessageId String?  @unique
  fromPhone      String
  text           String   @db.VarChar(2000)
  phoneNumberId  String?
  status         String   @default("pending")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lastError      String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, nextAttemptAt])
}

/// Sortants en échec / retry — évite perte de réponse + respect des limites Meta.
model WhatsAppOutboundQueue {
  id            String   @id @default(cuid())
  toPhone       String
  body          String   @db.VarChar(4096)
  phoneNumberId String?
  bodyHash      String
  status        String   @default("pending")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([toPhone, bodyHash, createdAt])
}

/// Idempotence webhooks Kapso (`X-Idempotency-Key`)
model WhatsAppWebhookDedup {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  eventName      String?
  processedAt    DateTime @default(now())
}

/// Packs combinés (ex: nounours + bouquet) — prévue pour usage futur
model PackCombine {
  id         String   @id @default(cuid())
  productAId String
  productBId String
  packPrice  Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
