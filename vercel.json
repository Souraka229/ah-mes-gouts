{
  "//crons": "Le plan Hobby limite Vercel a UN passage par jour et par cron. Ces deux entrees ne sont donc qu'un filet de securite quotidien. La cadence reelle vient de .github/workflows/cron.yml, qui appelle les memes routes toutes les 5 minutes. Passer en Pro permettrait de tout ramener ici.",
  "crons": [
    {
      "path": "/api/cron/activate-menus",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/reconcile-payments",
      "schedule": "30 19 * * *"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|avif|png|jpg|jpeg|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.giftentremets.com"
        }
      ],
      "destination": "https://giftentremets.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "gift-entremets.vercel.app"
        }
      ],
      "destination": "https://giftentremets.com/:path*",
      "permanent": true
    }
  ]
}
