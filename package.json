{
  "name": "gift-entremets",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node scripts/seed-db.mjs",
    "seed:legacy": "node scripts/seed-all.mjs",
    "seed:db": "node scripts/seed-db.mjs",
    "db:inspect": "node scripts/db-inspect.mjs",
    "db:health": "node scripts/db-health-check.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy:env": "node scripts/push-vercel-env.mjs",
    "sync:zones": "node scripts/sync-delivery-zones.mjs",
    "images:gift": "node scripts/import-gift-images.mjs",
    "images:optimize": "node scripts/optimize-produits-images.mjs",
    "images:restore": "node scripts/restore-produits-images.mjs && node scripts/optimize-produits-images.mjs",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
