// Schéma Prisma — Ah Mes Goûts (backend NestJS à brancher)
// Les champs expéditeur (client_*) restent toujours en base pour l'admin,
// même si sender_visible = false (anonymat = destinataire uniquement).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  RECUE
  PAIEMENT_CONFIRME
  PREPARATION
  PRETE
  EN_LIVRAISON
  LIVREE
  ANNULEE
}

enum ReceptionMode {
  DELIVERY
  PICKUP
  DINEIN
}

enum PaymentMethod {
  MTN_MOMO
  MOOV_MONEY
  CELTIIS_CASH
  CARD
}

enum PaymentAttemptStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

model DeliveryZone {
  id        String   @id @default(cuid())
  name      String
  cost      Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliverySchedule {
  id           String  @id @default(cuid())
  dayOfWeek    Int
  startTime    String
  endTime      String
  slotDuration Int     @default(30)
  type         String
  isActive     Boolean @default(true)
}

/// Réglages globaux livraison (créneaux, capacité) — édités par l'admin.
model DeliveryOptions {
  id               String   @id @default("default")
  maxOrdersPerSlot Int      @default(5)
  bookingDaysAhead Int      @default(7)
  pickupAddress    String   @default("Gift & ENTREMETS — Cotonou, Bénin")
  updatedAt        DateTime @updatedAt
}

model Driver {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  accessToken String   @unique @default(cuid())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  orders Order[]
}

/// Client CRM — pivot = téléphone normalisé (pas l'IP, pas le device).
model Customer {
  id           String    @id @default(cuid())
  phone        String    @unique
  firstName    String    @default("")
  lastName     String    @default("")
  firstOrderAt DateTime?
  lastOrderAt  DateTime?
  ordersCount  Int       @default(0)
  totalSpent   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  devices    CustomerDevice[]
  activities CustomerActivity[]
  orders     Order[]

  @@index([lastOrderAt])
  @@index([totalSpent])
  @@index([ordersCount])
}

/// Appareil navigateur (LocalStorage) — peut être lié à un Customer.
model CustomerDevice {
  id         String    @id @default(cuid())
  deviceKey  String    @unique
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  activities CustomerActivity[]

  @@index([customerId])
}

enum CustomerActivityType {
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_START
  ORDER_PLACED
}

model CustomerActivity {
  id          String               @id @default(cuid())
  deviceId    String
  device      CustomerDevice       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  type        CustomerActivityType
  productId   String?
  productSlug String?
  productName String?
  metadata    Json?
  createdAt   DateTime             @default(now())

  @@index([customerId, createdAt])
  @@index([deviceId, createdAt])
  @@index([type, createdAt])
}

/// Code à usage unique pour récupérer l'historique sur un nouvel appareil.
model CustomerOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Order {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status        OrderStatus   @default(RECUE)
  mode          ReceptionMode
  zoneId        String?
  zoneName      String?
  deliveryZoneId       String?
  scheduledSlotStart   DateTime?
  scheduledSlotEnd     DateTime?
  fulfillmentType      String    @default("delivery")
  deliveryFee   Int           @default(0)
  subtotal      Int
  total         Int
  paymentMethod PaymentMethod
  paymentReference String?

  /// Jeton de suivi opaque — remis une seule fois à la création.
  /// Exigé par /api/orders/[id]/tracking : ferme l'énumération de commandes.
  /// Nullable pour les commandes antérieures à la migration, qui restent
  /// consultables par ID seul le temps qu'elles sortent du circuit.
  trackingToken String? @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  driverId          String?
  driver            Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  driverStartedAt   DateTime?
  driverDeliveredAt DateTime?

  // Expéditeur / facturation (toujours stocké — visible admin uniquement si cadeau anonyme)
  clientFirstName String
  clientLastName  String
  clientPhone     String
  clientAddress   String?
  clientLandmark  String?
  clientMessage   String?

  // Commande cadeau
  isGift          Boolean @default(false)
  recipientName   String?
  recipientPhone  String?
  recipientAddress String?
  recipientLandmark String?
  giftMessage     String? @db.VarChar(280)
  senderVisible   Boolean @default(true)

  // Anti-fraude (IP hashée, jamais en clair)
  clientIpHash String?

  items    OrderItem[]
  attempts PaymentAttempt[]

  @@index([clientPhone])
  @@index([customerId])
  @@index([createdAt])
  @@index([driverId])
  @@index([driverId, fulfillmentType, status])
  @@index([driverId, scheduledSlotStart])
  @@index([status])
  @@index([scheduledSlotStart, fulfillmentType, status])
  @@index([paymentReference])
}

/// Tentative de paiement — l'objet qui manquait.
///
/// Une commande a des tentatives ; une tentative appartient à une commande et
/// une seule ; une référence FeexPay est unique GLOBALEMENT. C'est cette
/// contrainte d'unicité, au niveau base, qui rend le rejeu impossible : une
/// référence déjà encaissée ne peut plus créditer aucune autre commande.
///
/// `amount` est figé à l'initiation depuis le total serveur : le webhook
/// compare à cette valeur, jamais à un montant relu du client.
model PaymentAttempt {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  reference String               @unique
  method    PaymentMethod
  amount    Int
  status    PaymentAttemptStatus @default(PENDING)

  initiatedAt DateTime  @default(now())
  settledAt   DateTime?

  /// Dernière réponse FeexPay brute — indispensable en litige client.
  lastRawResponse Json?
  failureReason   String?

  @@index([status, initiatedAt])
  @@index([orderId])
}

/// Session admin signée et révocable — remplace le token statique en cookie.
model AdminSession {
  id         String    @id @default(cuid())
  role       String
  name       String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  ipHash     String?

  @@index([expiresAt])
}

/// Idempotence checkout — remplace le cache RAM multi-instance.
model OrderIdempotencyKey {
  key       String   @id
  orderId   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Rate limiting distribué (remplace Map process-local).
model RateLimitBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  slug     String?
  name     String
  quantity Int
  unitPrice Int
  supplements String[] @default([])
}

enum MenuStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
}

model Product {
  id              String   @id
  slug            String   @unique
  name            String
  description     String   @default("")
  price           Int
  imageUrl        String
  imageUrls       String[] @default([])
  keyword         String?
  stockRemaining  Int
  stockMinimum    Int      @default(5)
  isNew           Boolean  @default(false)
  isPromotion     Boolean  @default(false)
  promotionPrice  Int?
  isMenuDuJour    Boolean  @default(false)
  isPopular       Boolean  @default(false)
  isGiftCard      Boolean  @default(false)
  giftCardMessage String?
  category        String   @default("Entremets")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Menu {
  id           String     @id
  date         DateTime
  activateAt   DateTime
  status       MenuStatus
  productIds   String[]
  displayOrder Int[]
  /** Stock du jour par produit (aligné sur productIds) — appliqué à l'activation 20h. */
  dailyStock   Int[]      @default([])
  createdAt    DateTime   @default(now())

  @@index([status])
  @@index([activateAt])
}

model SiteSettingsStore {
  id        String   @id @default("default")
  data      Json
  updatedAt DateTime @updatedAt
}

model AdminActionLog {
  id        String   @id
  createdAt DateTime @default(now())
  adminName String
  source    String
  action    String
  summary   String
  details   Json?

  @@index([createdAt])
  @@index([source, createdAt])
}

/// Flux minimal pour Supabase Realtime (statut public sans PII)
model OrderStatusFeed {
  id        String      @id
  status    OrderStatus
  updatedAt DateTime    @updatedAt
}

/// Visiteur unique par jour (cookie amg_vid → hash) — analytics boutique
model SiteVisitorDay {
  id          String   @id @default(cuid())
  day         String
  visitorHash String
  pageViews   Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([day, visitorHash])
  @@index([day])
}

/// Abonnements Web Push (back-office) — remplace Telegram.
/// Table posée pour le canal à venir ; aucun code ne l'écrit encore.
model PushSubscription {
  id        String   @id @default(cuid())
  /// Endpoint fourni par le navigateur — identifie l'abonnement de façon unique.
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Rôle du destinataire : "administrateur" | "employe".
  role      String   @default("administrateur")
  label     String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([isActive])
}
